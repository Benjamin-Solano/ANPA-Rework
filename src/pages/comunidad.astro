---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import BusquedaIA from '../components/BusquedaIA.tsx';
import { refugios, mascotas, tablero, coincidencias } from '../data/comunidad.ts';

const zonas = ['all', ...Array.from(new Set(tablero.map((b) => b.zone)))];
---

<Base
  title="Comunidad"
  description="Comunidad ANPA: refugios verificados, adopciones seguras y búsqueda de mascotas perdidas con IA — sin fraudes de redes sociales."
>
  <Navbar active="comunidad" />

  <section class="cabecera">
    <div class="contenedor cabecera-inner">
      <h1 class="cabecera-h1">Comunidad</h1>
      <p class="cabecera-p">Refugios verificados, adopciones seguras y mascotas perdidas — sin fraudes de redes sociales.</p>
      <div class="tabs" role="tablist" aria-label="Comunidad">
        <button type="button" class="tab" data-tab="adopciones" role="tab" aria-selected="true">Adopciones</button>
        <button type="button" class="tab" data-tab="busqueda" role="tab" aria-selected="false">Mascotas perdidas</button>
      </div>
    </div>
  </section>

  <!-- ============ ADOPCIONES ============ -->
  <div id="adopciones" class="panel contenedor seccion" role="tabpanel">
    <h2 class="h2">Refugios verificados</h2>
    <p class="sub">Donar, voluntariar o adoptar con confianza.</p>
    <div class="refugios-grid">
      {
        refugios.map((s) => (
          <div class="refugio-card">
            <div class="refugio-cabeza">
              <div class="refugio-nombre">{s.name}</div>
              <div class="refugio-verificado">✓ Verificado</div>
            </div>
            <div class="refugio-ubicacion">{s.location}</div>
            <div class="refugio-barra">
              <div class="refugio-barra-fill" style={`width:${s.pct}%`} />
            </div>
            <div class="refugio-recaudo">{s.raised} recaudado de {s.goal}</div>
            <div class="refugio-acciones">
              <button type="button" class="refugio-donar">Donar</button>
              <button type="button" class="refugio-voluntariar">Voluntariar</button>
            </div>
          </div>
        ))
      }
    </div>

    <h2 class="h2">Mascotas en adopción</h2>
    <p class="sub">Publicadas por refugios verificados.</p>
    <div class="pets-grid">
      {
        mascotas.map((p) => (
          <div class="pet-card">
            <img class="pet-img" src={p.img} alt={p.name} width="300" height="200" loading="lazy" />
            <div class="pet-cuerpo">
              <div class="pet-cabeza">
                <div class="pet-nombre">{p.name}</div>
                <div class="pet-edad">{p.age}</div>
              </div>
              <div class="pet-meta">{p.sex} · {p.size} · {p.shelter}</div>
              <div class="pet-notas">{p.notes}</div>
              <button type="button" class="pet-postular">Ver ficha y postular</button>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- ============ BÚSQUEDA ============ -->
  <div id="busqueda" class="panel contenedor seccion" role="tabpanel" hidden>
    <BusquedaIA coincidencias={coincidencias} client:load />

    <h2 class="h2">Tablero de búsqueda</h2>
    <p class="sub">Reportes activos de la comunidad — filtrá por tipo o por zona.</p>

    <div class="board-filtros" role="group" aria-label="Filtrar por tipo">
      <button type="button" class="board-filtro activo" data-board-type="all">Todos</button>
      <button type="button" class="board-filtro" data-board-type="perdido">Perdidos</button>
      <button type="button" class="board-filtro" data-board-type="encontrado">Encontrados</button>
    </div>
    <div class="board-zonas" role="group" aria-label="Filtrar por zona">
      {
        zonas.map((z) => (
          <button type="button" class:list={['board-zona', { activo: z === 'all' }]} data-board-zone={z}>
            {z === 'all' ? 'Todas las zonas' : z}
          </button>
        ))
      }
    </div>

    <div class="board-grid" id="board-grid">
      {
        tablero.map((b) => (
          <div class="board-card" data-type={b.type} data-zone={b.zone}>
            <div class="board-img-wrap">
              <img class="board-img" src={b.img} alt={b.name} width="220" height="130" loading="lazy" />
              <span class:list={['board-badge', b.type]}>{b.type === 'perdido' ? 'PERDIDO' : 'ENCONTRADO'}</span>
            </div>
            <div class="board-cuerpo">
              <div class="board-nombre">{b.name}</div>
              <div class="board-meta">{b.zone} · {b.date}</div>
            </div>
          </div>
        ))
      }
    </div>
    <div class="board-vacio" id="board-vacio" hidden>No hay reportes que coincidan con esos filtros.</div>
  </div>

  <Footer />
</Base>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab');
  const panels: Record<string, HTMLElement | null> = {
    adopciones: document.getElementById('adopciones'),
    busqueda: document.getElementById('busqueda'),
  };

  function activateTab(name: string) {
    if (!panels[name]) return;
    tabs.forEach((t) => {
      const active = t.dataset.tab === name;
      t.classList.toggle('activo', active);
      t.setAttribute('aria-selected', String(active));
    });
    Object.entries(panels).forEach(([key, el]) => {
      if (el) el.hidden = key !== name;
    });
  }

  tabs.forEach((t) => {
    t.addEventListener('click', () => {
      activateTab(t.dataset.tab!);
      history.replaceState(null, '', `#${t.dataset.tab}`);
    });
  });

  function syncFromHash() {
    const name = location.hash.replace('#', '');
    if (panels[name]) activateTab(name);
  }
  syncFromHash();
  document.addEventListener('astro:page-load', syncFromHash);
  window.addEventListener('hashchange', syncFromHash);

  // Si ya estamos en /comunidad, un clic en un enlace #adopciones/#busqueda (submenú, footer)
  // es interceptado por el ClientRouter de Astro con history.pushState, que NO dispara
  // 'hashchange' ni 'astro:page-load' al no haber swap de página. Lo resolvemos directo.
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest('a[href*="#"]');
    if (!a) return;
    const url = new URL((a as HTMLAnchorElement).href);
    if (url.pathname === location.pathname && panels[url.hash.replace('#', '')]) {
      activateTab(url.hash.replace('#', ''));
    }
  });

  // Filtros del tablero: tipo + zona combinados.
  const typeButtons = document.querySelectorAll<HTMLButtonElement>('.board-filtro');
  const zoneButtons = document.querySelectorAll<HTMLButtonElement>('.board-zona');
  const boardCards = document.querySelectorAll<HTMLElement>('.board-card');
  const boardVacio = document.getElementById('board-vacio');
  const boardGrid = document.getElementById('board-grid');
  let currentType = 'all';
  let currentZone = 'all';

  function applyBoardFilters() {
    let visible = 0;
    boardCards.forEach((card) => {
      const matchesType = currentType === 'all' || card.dataset.type === currentType;
      const matchesZone = currentZone === 'all' || card.dataset.zone === currentZone;
      const show = matchesType && matchesZone;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    if (boardVacio) boardVacio.hidden = visible > 0;
    if (boardGrid) boardGrid.hidden = visible === 0;
  }

  typeButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      typeButtons.forEach((b) => b.classList.remove('activo'));
      btn.classList.add('activo');
      currentType = btn.dataset.boardType || 'all';
      applyBoardFilters();
    });
  });
  zoneButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      zoneButtons.forEach((b) => b.classList.remove('activo'));
      btn.classList.add('activo');
      currentZone = btn.dataset.boardZone || 'all';
      applyBoardFilters();
    });
  });
</script>

<style>
  .cabecera {
    background: linear-gradient(135deg, var(--rojo), #8e0e22);
    padding: 52px 0 40px;
    text-align: center;
  }
  .cabecera-inner {
    max-width: 700px;
  }
  .cabecera-h1 {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 32px;
    color: #fff;
    margin: 0 0 10px;
  }
  .cabecera-p {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 26px;
  }
  .tabs {
    display: inline-flex;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 30px;
    padding: 5px;
  }
  .tab {
    padding: 9px 22px;
    border-radius: 24px;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    border: none;
    background: transparent;
    color: #fff;
  }
  .tab.activo {
    background: rgba(255, 255, 255, 0.92);
    color: var(--rojo);
  }

  .seccion {
    padding-top: 48px;
    padding-bottom: 64px;
  }
  .h2 {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 22px;
    color: var(--tinta);
    margin: 0 0 6px;
  }
  .sub {
    font-size: 14px;
    color: var(--texto-3);
    margin: 0 0 20px;
  }

  /* Refugios */
  .refugios-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
    margin-bottom: 56px;
  }
  .refugio-card {
    border-radius: 20px;
    padding: 24px;
    background: var(--blanco);
    border: 1px solid var(--borde);
    box-shadow: var(--sombra-tarjeta);
  }
  .refugio-cabeza {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 8px;
  }
  .refugio-nombre {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 15px;
    color: var(--tinta);
  }
  .refugio-verificado {
    font-size: 10px;
    font-weight: 700;
    color: var(--verde);
    background: var(--verde-suave);
    padding: 4px 8px;
    border-radius: 10px;
    flex-shrink: 0;
    white-space: nowrap;
  }
  .refugio-ubicacion {
    font-size: 12.5px;
    color: var(--texto-3);
    margin-bottom: 14px;
  }
  .refugio-barra {
    height: 10px;
    border-radius: 6px;
    background: var(--borde-2);
    overflow: hidden;
    margin-bottom: 6px;
  }
  .refugio-barra-fill {
    height: 100%;
    border-radius: 6px;
    background: var(--rojo);
  }
  .refugio-recaudo {
    font-size: 11.5px;
    color: var(--texto-3);
    margin-bottom: 16px;
  }
  .refugio-acciones {
    display: flex;
    gap: 8px;
  }
  .refugio-donar,
  .refugio-voluntariar {
    flex: 1;
    text-align: center;
    padding: 8px;
    border-radius: 20px;
    font-size: 12.5px;
    font-weight: 700;
    cursor: pointer;
    border: none;
    font-family: var(--font-body);
  }
  .refugio-donar {
    background: var(--verde);
    color: #fff;
  }
  .refugio-donar:hover {
    background: var(--verde-hover);
  }
  .refugio-voluntariar {
    background: var(--blanco);
    border: 1px solid var(--borde);
    color: var(--texto-2);
    border-radius: 8px;
  }

  /* Mascotas en adopción */
  .pets-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 18px;
  }
  .pet-card {
    border-radius: 18px;
    overflow: hidden;
    background: var(--blanco);
    border: 1px solid var(--borde);
    box-shadow: var(--sombra-tarjeta);
  }
  .pet-img {
    width: 100%;
    height: 160px;
    object-fit: cover;
    background: var(--img-fallback);
  }
  .pet-cuerpo {
    padding: 16px;
  }
  .pet-cabeza {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 4px;
  }
  .pet-nombre {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 15px;
    color: var(--tinta);
  }
  .pet-edad {
    font-size: 12px;
    color: var(--texto-3);
  }
  .pet-meta {
    font-size: 12px;
    color: var(--texto-3);
    margin-bottom: 10px;
  }
  .pet-notas {
    font-size: 12px;
    color: #4a423c;
    line-height: 1.5;
    margin-bottom: 14px;
  }
  .pet-postular {
    width: 100%;
    text-align: center;
    padding: 9px;
    border-radius: 8px;
    background: var(--tinta);
    color: #fff;
    font-size: 12.5px;
    font-weight: 700;
    cursor: pointer;
    border: none;
    font-family: var(--font-body);
  }

  /* Tablero */
  .board-filtros {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }
  .board-zonas {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .board-filtro,
  .board-zona {
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 12.5px;
    font-weight: 600;
    cursor: pointer;
    background: var(--crema);
    border: 1px solid var(--borde);
    color: var(--texto-2);
    font-family: var(--font-body);
  }
  .board-zona {
    padding: 7px 14px;
    border-radius: 16px;
    font-size: 12px;
  }
  .board-filtro.activo {
    background: var(--rojo);
    border-color: var(--rojo);
    color: #fff;
  }
  .board-zona.activo {
    background: var(--tinta);
    border-color: var(--tinta);
    color: #fff;
  }
  .board-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }
  .board-card {
    border-radius: 16px;
    overflow: hidden;
    background: var(--blanco);
    border: 1px solid var(--borde);
    box-shadow: var(--sombra-tarjeta);
  }
  .board-img-wrap {
    position: relative;
    height: 130px;
  }
  .board-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--img-fallback);
  }
  .board-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    font-size: 10px;
    font-weight: 700;
    padding: 4px 9px;
    border-radius: 10px;
    color: #fff;
  }
  .board-badge.perdido {
    background: var(--rojo);
  }
  .board-badge.encontrado {
    background: var(--verde);
  }
  .board-cuerpo {
    padding: 14px;
  }
  .board-nombre {
    font-weight: 700;
    font-size: 13.5px;
    color: var(--tinta);
    margin-bottom: 4px;
  }
  .board-meta {
    font-size: 12px;
    color: var(--texto-3);
  }
  .board-vacio {
    padding: 32px;
    text-align: center;
    color: var(--tenue);
    font-size: 13.5px;
    background: var(--crema);
    border-radius: 12px;
  }

  @media (max-width: 900px) {
    .refugios-grid,
    .pets-grid,
    .board-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
