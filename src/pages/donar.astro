---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

// PLACEHOLDER: montos sugeridos. Aún sin pasarela de pago real (§ pendiente producción).
const montos = [
  { monto: '₡5.000', detalle: 'Cubre vacunas para 5 animales rescatados.' },
  { monto: '₡15.000', detalle: 'Financia una castración completa.' },
  { monto: '₡30.000', detalle: 'Sostiene un taller de educación en una escuela.' },
];
---

<Base
  title="Donar"
  description="Sumate a ANPA Costa Rica. Tu aporte se convierte en castraciones, rescates y educación. Cada colón llega directo a los programas de bienestar animal."
>
  <Navbar active="donar" />

  <section class="donar">
    <div class="contenedor donar-grid">
      <div>
        <span class="etiqueta-seccion c-verde">Sumate hoy</span>
        <h1 class="donar-h1">Tu aporte se convierte en vidas salvadas</h1>
        <p class="donar-p">
          Cada colón llega directo a los programas de castración, rescate y educación. Elegí un monto y
          ayudanos a construir un país donde ningún animal quede atrás.
        </p>
        <ul class="donar-lista">
          <li>Organización declarada de utilidad pública desde 2019.</li>
          <li>46 años de trayectoria en bienestar animal.</li>
          <li>Presencia en 56 gobiernos locales de todo el país.</li>
        </ul>
      </div>

      <div class="donar-panel">
        <h2 class="donar-panel-h2">Elegí tu aporte</h2>
        <div class="donar-montos">
          {
            montos.map((m) => (
              <button class="donar-monto" type="button">
                <span class="donar-monto-cifra">{m.monto}</span>
                <span class="donar-monto-detalle">{m.detalle}</span>
              </button>
            ))
          }
        </div>
        <a href="#" class="btn-donar donar-cta">
          Continuar con la donación
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21s-7.5-4.6-10-9.2C.3 8.5 1.7 5 5 5c2 0 3.2 1.2 4 2.3C9.8 6.2 11 5 13 5c3.3 0 4.7 3.5 3 6.8C19.5 16.4 12 21 12 21z"></path></svg>
        </a>
        <p class="donar-nota">Integración con pasarela de pago próximamente.</p>
      </div>
    </div>
  </section>

  <Footer />
</Base>

<style>
  .c-verde {
    color: var(--verde);
  }
  .donar {
    padding: 72px 0 88px;
  }
  .donar-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .donar-h1 {
    font-weight: 900;
    font-size: 42px;
    letter-spacing: -1px;
    margin: 10px 0 18px;
    line-height: 1.1;
    color: var(--tinta);
    text-wrap: balance;
  }
  .donar-p {
    font-size: 17px;
    line-height: 1.7;
    color: var(--texto-2);
    margin: 0 0 24px;
  }
  .donar-lista {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 15.5px;
    color: #3a3633;
  }
  .donar-lista li {
    padding-left: 26px;
    position: relative;
  }
  .donar-lista li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--verde);
    font-weight: 800;
  }

  .donar-panel {
    background: var(--blanco);
    border: 1px solid var(--borde);
    border-radius: 22px;
    padding: 36px 32px;
    box-shadow: var(--sombra-tarjeta);
  }
  .donar-panel-h2 {
    font-weight: 800;
    font-size: 22px;
    margin: 0 0 20px;
    color: var(--tinta);
  }
  .donar-montos {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 24px;
  }
  .donar-monto {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
    text-align: left;
    background: var(--crema);
    border: 1px solid var(--borde);
    border-radius: 14px;
    padding: 16px 18px;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
  }
  .donar-monto:hover {
    border-color: var(--verde);
    background: var(--verde-suave);
  }
  .donar-monto-cifra {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 20px;
    color: var(--tinta);
  }
  .donar-monto-detalle {
    font-size: 13.5px;
    color: var(--texto-3);
  }
  .donar-cta {
    width: 100%;
    font-size: 17px;
    padding: 16px;
    border-radius: 13px;
    box-shadow: none;
  }
  .donar-nota {
    text-align: center;
    font-size: 12.5px;
    color: var(--tenue-2);
    margin: 14px 0 0;
  }

  @media (max-width: 900px) {
    .donar-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
