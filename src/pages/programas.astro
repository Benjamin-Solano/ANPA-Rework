---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { programas } from '../data/programas.ts';
---

<Base
  title="Programas"
  description="Conocé los programas de ANPA Costa Rica: ANPA Castra (castración preventiva), ANPA Educa (educación en bienestar animal) y FOCABA (foro centroamericano de bienestar animal)."
>
  <Navbar active="programas" />

  <!-- ENCABEZADO -->
  <section class="cabecera">
    <div class="contenedor">
      <span class="etiqueta-seccion c-rojo">Nuestros programas</span>
      <h1 class="cabecera-h1">Tres frentes, un mismo propósito</h1>
      <p class="cabecera-p">
        Trabajamos con un enfoque preventivo, educativo y participativo para transformar la vida de los
        animales y sus comunidades en todo el país.
      </p>
    </div>
  </section>

  <!-- SECCIONES POR PROGRAMA -->
  {
    programas.map((p, i) => (
      <section id={p.slug} class:list={['programa', { alterna: i % 2 === 1 }]}>
        <div class="contenedor programa-grid">
          <div class="programa-img-wrap">
            <img class="programa-img" src={p.img} alt={p.alt} width="600" height="400" loading="lazy" />
            <span
              class="programa-icono"
              aria-hidden="true"
              style={`background:${p.tone === 'rojo' ? 'var(--rojo)' : 'var(--verde)'}`}
              set:html={p.icon}
            />
          </div>
          <div>
            <h2 class="programa-titulo">{p.title}</h2>
            <p class="programa-detalle">{p.detalle}</p>
            <a href="/donar" class="btn-donar programa-cta">
              Apoyar este programa
            </a>
          </div>
        </div>
      </section>
    ))
  }

  <Footer />
</Base>

<style>
  .c-rojo {
    color: var(--rojo);
  }
  .cabecera {
    padding: 72px 0 48px;
  }
  .cabecera-h1 {
    font-weight: 900;
    font-size: 44px;
    letter-spacing: -1px;
    margin: 10px 0 16px;
    color: var(--tinta);
    text-wrap: balance;
  }
  .cabecera-p {
    font-size: 18px;
    line-height: 1.7;
    color: var(--texto-2);
    max-width: 620px;
    margin: 0;
  }

  .programa {
    padding: 56px 0;
  }
  .programa.alterna {
    background: var(--blanco);
    border-top: 1px solid var(--borde-2);
    border-bottom: 1px solid var(--borde-2);
  }
  .programa-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .programa.alterna .programa-grid {
    direction: rtl;
  }
  .programa.alterna .programa-grid > * {
    direction: ltr;
  }
  .programa-img-wrap {
    position: relative;
  }
  .programa-img {
    width: 100%;
    height: 340px;
    object-fit: cover;
    border-radius: 20px;
    background: var(--img-fallback);
  }
  .programa-icono {
    position: absolute;
    left: 16px;
    bottom: -20px;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 20px -8px rgba(0, 0, 0, 0.4);
  }
  .programa-titulo {
    font-weight: 800;
    font-size: 30px;
    letter-spacing: -0.6px;
    margin: 0 0 16px;
    color: var(--tinta);
  }
  .programa-detalle {
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--texto-2);
    margin: 0 0 26px;
  }
  .programa-cta {
    font-size: 16px;
    padding: 14px 26px;
  }

  @media (max-width: 900px) {
    .programa-grid,
    .programa.alterna .programa-grid {
      grid-template-columns: 1fr;
      direction: ltr;
    }
    .programa-img {
      height: 260px;
    }
  }
</style>
