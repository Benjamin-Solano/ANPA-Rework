---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Counters from '../components/Counters.tsx';
import ProgramCard from '../components/ProgramCard.astro';
import NewsCard from '../components/NewsCard.astro';
import DonationGoal from '../components/DonationGoal.astro';
import Allies from '../components/Allies.astro';
import { counters } from '../data/counters.ts';
import { programas } from '../data/programas.ts';

const noticias = (await getCollection('noticias')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const tickSvg =
  '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>';
---

<Base
  title="Inicio"
  description="ANPA Costa Rica: rescatamos, sanamos y protegemos a miles de animales cada año mediante castración preventiva, educación y comunidad. La ONG de bienestar animal más antigua del país."
>
  <Navbar active="inicio" />

  <Hero />

  <!-- CONTADORES -->
  <section id="impacto" class="contenedor seccion" aria-label="Nuestro impacto">
    <div class="seccion-head centrado">
      <span class="etiqueta-seccion c-rojo">Impacto en cifras</span>
      <h2 class="seccion-h2">Resultados que transforman comunidades</h2>
    </div>
    <Counters counters={counters} client:visible />
  </section>

  <!-- MISIÓN -->
  <section id="mision" class="contenedor seccion-mision">
    <div class="mision-grid">
      <div class="mision-img-wrap">
        <img
          class="mision-img"
          src="https://images.unsplash.com/photo-1583337130417-3346a1be7dee?auto=format&fit=crop&w=900&q=80"
          alt="Gato atendido en una jornada de ANPA"
          width="900"
          height="1000"
          loading="lazy"
        />
        <div class="mision-badge">
          <div class="mision-badge-anio">1980</div>
          <div class="mision-badge-sub">Fundada · ONG pionera del país</div>
        </div>
      </div>
      <div>
        <span class="etiqueta-seccion c-verde">Quiénes somos</span>
        <h2 class="mision-h2">Bienestar animal, humano y ambiental: una sola salud.</h2>
        <p class="mision-p">
          La Asociación Nacional Protectora de Animales es la organización de bienestar animal más
          antigua de Costa Rica. Trabajamos con un enfoque preventivo, educativo y participativo,
          alineados con la Agenda 2030.
        </p>
        <ul class="mision-lista">
          <li><span class="tick" set:html={tickSvg} />Declarada de utilidad pública por el Estado en 2019.</li>
          <li><span class="tick" set:html={tickSvg} />Programas con impacto económico, social y ambiental.</li>
          <li><span class="tick" set:html={tickSvg} />Presencia en 56 gobiernos locales de todo el país.</li>
        </ul>
        <a href="/programas" class="enlace-accion">
          Ver nuestros programas
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- PROGRAMAS -->
  <section class="banda-blanca">
    <div class="contenedor seccion">
      <div class="seccion-head fila">
        <div>
          <span class="etiqueta-seccion c-rojo">Nuestros programas</span>
          <h2 class="seccion-h2">Tres frentes, un mismo propósito</h2>
        </div>
        <a href="/programas" class="enlace-accion c-verde-link">
          Ver todos
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
      </div>
      <div class="grid-3">
        {programas.map((p) => <ProgramCard programa={p} />)}
      </div>
    </div>
  </section>

  <!-- META DE DONACIÓN -->
  <DonationGoal />

  <!-- NOTICIAS -->
  <section id="noticias" class="banda-blanca">
    <div class="contenedor seccion">
      <div class="seccion-head">
        <span class="etiqueta-seccion c-verde">Actividad reciente</span>
        <h2 class="seccion-h2">Últimas noticias</h2>
      </div>
      <div class="grid-3">
        {
          noticias.map((n) => (
            <NewsCard
              title={n.data.title}
              tag={n.data.tag}
              tone={n.data.tone}
              date={n.data.date}
              image={n.data.image}
              alt={n.data.alt}
              excerpt={n.data.excerpt}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ALIADOS -->
  <Allies />

  <Footer />
</Base>

<style>
  .seccion {
    padding-top: 64px;
    padding-bottom: 64px;
  }
  .seccion-head {
    margin-bottom: 40px;
  }
  .seccion-head.centrado {
    text-align: center;
  }
  .seccion-head.fila {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
    align-items: flex-end;
  }
  .seccion-h2 {
    font-weight: 800;
    font-size: 34px;
    letter-spacing: -0.8px;
    margin: 8px 0 0;
    color: var(--tinta);
  }
  .c-rojo {
    color: var(--rojo);
  }
  .c-verde {
    color: var(--verde);
  }
  .c-verde-link {
    color: var(--verde);
  }

  .banda-blanca {
    background: var(--blanco);
    border-top: 1px solid var(--borde-2);
    border-bottom: 1px solid var(--borde-2);
  }
  .banda-blanca + .banda-blanca {
    border-top: none;
  }

  .grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  /* Misión */
  .seccion-mision {
    padding-top: 48px;
    padding-bottom: 72px;
  }
  .mision-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: center;
  }
  .mision-img-wrap {
    position: relative;
  }
  .mision-img {
    width: 100%;
    height: 440px;
    object-fit: cover;
    border-radius: 22px;
    background: var(--img-fallback);
  }
  .mision-badge {
    position: absolute;
    left: -14px;
    bottom: -18px;
    background: var(--rojo);
    color: #fff;
    border-radius: 18px;
    padding: 18px 22px;
    box-shadow: 0 18px 40px -18px rgba(212, 35, 43, 0.7);
  }
  .mision-badge-anio {
    font-family: var(--font-head);
    font-weight: 900;
    font-size: 30px;
    line-height: 1;
  }
  .mision-badge-sub {
    font-size: 12.5px;
    font-weight: 600;
    opacity: 0.9;
    margin-top: 2px;
  }
  .mision-h2 {
    font-weight: 800;
    font-size: 36px;
    letter-spacing: -1px;
    margin: 10px 0 18px;
    line-height: 1.1;
    color: var(--tinta);
  }
  .mision-p {
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--texto-2);
    margin: 0 0 18px;
  }
  .mision-lista {
    list-style: none;
    padding: 0;
    margin: 0 0 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .mision-lista li {
    display: flex;
    gap: 11px;
    align-items: flex-start;
    font-size: 15.5px;
    color: #3a3633;
  }
  .tick {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--verde);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 1px;
  }

  @media (max-width: 900px) {
    .grid-3 {
      grid-template-columns: 1fr;
    }
    .mision-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
