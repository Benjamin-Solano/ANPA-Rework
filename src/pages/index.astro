---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Counters from '../components/Counters.tsx';
import ProgramCard from '../components/ProgramCard.astro';
import NewsCard from '../components/NewsCard.astro';
import DonationGoal from '../components/DonationGoal.astro';
import Allies from '../components/Allies.astro';
import Carousel from '../components/Carousel.tsx';
import { counters } from '../data/counters.ts';
import { programas } from '../data/programas.ts';

const noticias = (await getCollection('noticias')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const tickSvg =
  '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>';

// Tarjeta de FOCABA para el grid de "Nuestros programas": mismo componente que Castra/Educa,
// pero enlaza a /focaba (página propia) en vez de un ancla dentro de /programas.
const focabaCard = {
  slug: 'focaba',
  title: 'FOCABA',
  tone: 'rojo' as const,
  img: 'https://images.unsplash.com/photo-1559027615-cd4628902d4a?auto=format&fit=crop&w=600&q=80',
  alt: 'Encuentro regional de bienestar animal',
  icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 2.5 15.3 0 18M12 3c-2.5 2.7-2.5 15.3 0 18"/></svg>',
  desc: 'Foro Centroamericano de Bienestar Animal: articulamos políticas y alianzas regionales.',
  detalle: '',
};

const momentos = [
  { label: 'jornada de castración', img: 'https://images.unsplash.com/photo-1576201836106-db1758fd1c97?auto=format&fit=crop&w=1200&q=80', alt: 'Jornada de castración de ANPA' },
  { label: 'niños FOCABA en taller', img: 'https://images.unsplash.com/photo-1503454537195-1dcabb73ffb9?auto=format&fit=crop&w=1200&q=80', alt: 'Niños en taller de FOCABA' },
  { label: 'adopción exitosa', img: 'https://images.unsplash.com/photo-1601758228041-f3b2795255f1?auto=format&fit=crop&w=1200&q=80', alt: 'Familia con su mascota recién adoptada' },
  { label: 'voluntariado comunitario', img: 'https://images.unsplash.com/photo-1593871075120-982e042088d8?auto=format&fit=crop&w=1200&q=80', alt: 'Voluntarios de ANPA en jornada comunitaria' },
];

const exploraCards = [
  { title: 'Programas', desc: 'ANPA Castra y ANPA Educa', href: '/programas' },
  { title: 'FOCABA', desc: 'Educación en bienestar animal', href: '/focaba' },
  { title: 'Donaciones', desc: 'Apoyá con transparencia', href: '/donar' },
  { title: 'Comunidad', desc: 'Adopciones y mascotas perdidas', href: '/comunidad' },
];
---

<Base
  title="Inicio"
  description="ANPA Costa Rica: rescatamos, sanamos y protegemos a miles de animales cada año mediante castración preventiva, educación y comunidad. La ONG de bienestar animal más antigua del país."
>
  <Navbar active="inicio" />

  <Hero />

  <!-- CONTADORES -->
  <section id="impacto" class="contenedor seccion" aria-label="Nuestro impacto">
    <div class="seccion-head centrado">
      <span class="etiqueta-seccion c-rojo">Impacto en cifras</span>
      <h2 class="seccion-h2">Resultados que transforman comunidades</h2>
    </div>
    <Counters counters={counters} client:visible />
  </section>

  <!-- MISIÓN -->
  <section id="mision" class="contenedor seccion-mision">
    <div class="mision-grid">
      <div class="mision-img-wrap">
        <img
          class="mision-img"
          src="https://images.unsplash.com/photo-1583337130417-3346a1be7dee?auto=format&fit=crop&w=900&q=80"
          alt="Gato atendido en una jornada de ANPA"
          width="900"
          height="1000"
          loading="lazy"
        />
        <div class="mision-badge">
          <div class="mision-badge-anio">1980</div>
          <div class="mision-badge-sub">Fundada · ONG pionera del país</div>
        </div>
      </div>
      <div>
        <span class="etiqueta-seccion c-verde">Quiénes somos</span>
        <h2 class="mision-h2">Bienestar animal, humano y ambiental: una sola salud.</h2>
        <p class="mision-p">
          La Asociación Nacional Protectora de Animales es la organización de bienestar animal más
          antigua de Costa Rica. Trabajamos con un enfoque preventivo, educativo y participativo,
          alineados con la Agenda 2030.
        </p>
        <ul class="mision-lista">
          <li><span class="tick" set:html={tickSvg} />Declarada de utilidad pública por el Estado en 2019.</li>
          <li><span class="tick" set:html={tickSvg} />Programas con impacto económico, social y ambiental.</li>
          <li><span class="tick" set:html={tickSvg} />Presencia en 56 gobiernos locales de todo el país.</li>
        </ul>
        <a href="/programas" class="enlace-accion">
          Ver nuestros programas
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- UNA SOLA SALUD (ODS) -->
  <section class="contenedor seccion-ods">
    <img
      class="ods-img"
      src="https://images.unsplash.com/photo-1548767797-d8c844163c4c?auto=format&fit=crop&w=700&q=80"
      alt="Veterinaria de ANPA atendiendo a un perro en comunidad"
      width="700"
      height="500"
      loading="lazy"
    />
    <div>
      <span class="etiqueta-seccion c-rojo">Nuestro enfoque</span>
      <h2 class="ods-h2">Una sola salud</h2>
      <p class="ods-p">
        Nuestras metas se alinean con la Agenda 2030 y los Objetivos de Desarrollo Sostenible (ODS),
        especialmente en los ámbitos de salud, educación y sostenibilidad ambiental. ANPA se define por
        su capacidad de transformarse y transformar, consolidándose como una organización disruptiva que
        supera la idea tradicional de «protectora de animales».
      </p>
      <p class="ods-p">
        Nuestro trabajo parte de la visión de una sola salud <em>(One Health)</em>, donde el bienestar
        animal, humano y ambiental son interdependientes. Impulsamos programas con enfoque preventivo,
        educativo y participativo, en distintos niveles de involucramiento comunitario.
      </p>
    </div>
  </section>

  <!-- DIVISOR -->
  <div class="contenedor divisor">
    <div class="divisor-linea"></div>
    <div class="divisor-icono" aria-hidden="true">
      <svg viewBox="0 0 100 100" width="20" height="20">
        <ellipse cx="50" cy="68" rx="24" ry="18" fill="#fff" />
        <ellipse cx="18" cy="34" rx="9" ry="12" transform="rotate(-18 18 34)" fill="#fff" />
        <ellipse cx="42" cy="15" rx="9" ry="12" fill="#fff" />
        <ellipse cx="64" cy="15" rx="9" ry="12" fill="#fff" />
        <ellipse cx="88" cy="34" rx="9" ry="12" transform="rotate(18 88 34)" fill="#fff" />
      </svg>
    </div>
    <div class="divisor-linea"></div>
  </div>

  <!-- MISIÓN Y VISIÓN -->
  <section class="contenedor seccion-mv">
    <div class="mv-card">
      <h3 class="mv-h3">Misión</h3>
      <p class="mv-p">
        Promover una cultura de respeto hacia los animales de compañía que genere bienestar para todos
        por igual, desarrollando programas innovadores de educación y manejo humanitario de poblaciones.
      </p>
    </div>
    <div class="mv-card">
      <h3 class="mv-h3">Visión</h3>
      <p class="mv-p">
        Lograr el mayor impacto en el bienestar animal en Costa Rica, Centroamérica y el Caribe, por la
        efectividad de nuestros programas socioeducativos, comunitarios y de triple impacto: económico,
        social y ambiental.
      </p>
    </div>
  </section>

  <!-- PROGRAMAS -->
  <section class="banda-blanca">
    <div class="contenedor seccion">
      <div class="seccion-head fila">
        <div>
          <span class="etiqueta-seccion c-rojo">Nuestros programas</span>
          <h2 class="seccion-h2">Tres frentes, un mismo propósito</h2>
        </div>
        <a href="/programas" class="enlace-accion c-verde-link">
          Ver todos
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
      </div>
      <div class="grid-3">
        {programas.map((p) => <ProgramCard programa={p} />)}
        <ProgramCard programa={focabaCard} href="/focaba" />
      </div>
    </div>
  </section>

  <!-- META DE DONACIÓN -->
  <DonationGoal />

  <!-- MOMENTOS ANPA (carrusel) -->
  <section class="banda-blanca">
    <div class="contenedor seccion">
      <Carousel slides={momentos} client:visible />
    </div>
  </section>

  <!-- NOTICIAS -->
  <section id="noticias">
    <div class="contenedor seccion">
      <div class="seccion-head">
        <span class="etiqueta-seccion c-verde">Actividad reciente</span>
        <h2 class="seccion-h2">Últimas noticias</h2>
      </div>
      <div class="grid-3">
        {
          noticias.map((n) => (
            <NewsCard
              title={n.data.title}
              tag={n.data.tag}
              tone={n.data.tone}
              date={n.data.date}
              image={n.data.image}
              alt={n.data.alt}
              excerpt={n.data.excerpt}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- EXPLORA LA PLATAFORMA -->
  <section class="banda-blanca">
    <div class="contenedor seccion explora-seccion">
      <h2 class="seccion-h2 explora-h2">Explorá la plataforma</h2>
      <div class="explora-grid">
        {
          exploraCards.map((c) => (
            <a class="explora-card" href={c.href}>
              <div class="explora-icono" aria-hidden="true" />
              <div class="explora-titulo">{c.title}</div>
              <div class="explora-desc">{c.desc}</div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ALIADOS -->
  <Allies />

  <Footer />
</Base>

<style>
  .seccion {
    padding-top: 64px;
    padding-bottom: 64px;
  }
  .seccion-head {
    margin-bottom: 40px;
  }
  .seccion-head.centrado {
    text-align: center;
  }
  .seccion-head.fila {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
    align-items: flex-end;
  }
  .seccion-h2 {
    font-weight: 800;
    font-size: 34px;
    letter-spacing: -0.8px;
    margin: 8px 0 0;
    color: var(--tinta);
  }
  .c-rojo {
    color: var(--rojo);
  }
  .c-verde {
    color: var(--verde);
  }
  .c-verde-link {
    color: var(--verde);
  }

  .banda-blanca {
    background: var(--blanco);
    border-top: 1px solid var(--borde-2);
    border-bottom: 1px solid var(--borde-2);
  }
  .banda-blanca + .banda-blanca {
    border-top: none;
  }

  .grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  /* Una sola salud (ODS) */
  .seccion-ods {
    padding-top: 56px;
    padding-bottom: 56px;
    display: grid;
    grid-template-columns: 0.85fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .ods-img {
    width: 100%;
    height: 320px;
    object-fit: cover;
    border-radius: 22px;
    background: var(--img-fallback);
  }
  .ods-h2 {
    font-weight: 800;
    font-size: 30px;
    letter-spacing: -0.4px;
    margin: 8px 0 16px;
    color: var(--tinta);
  }
  .ods-p {
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--texto-2);
    margin: 0 0 14px;
  }

  /* Divisor */
  .divisor {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 8px 24px 16px;
  }
  .divisor-linea {
    flex: 1;
    height: 1px;
    background: var(--borde-2);
  }
  .divisor-icono {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--rojo);
    box-shadow: 0 6px 16px -4px rgba(196, 18, 48, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* Misión y Visión */
  .seccion-mv {
    padding-top: 8px;
    padding-bottom: 64px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }
  .mv-card {
    background: #f8f4f1;
    border-radius: 22px;
    padding: 32px;
  }
  .mv-h3 {
    font-weight: 800;
    font-size: 19px;
    letter-spacing: -0.2px;
    color: var(--rojo);
    margin: 0 0 12px;
  }
  .mv-p {
    font-size: 15px;
    line-height: 1.75;
    color: var(--texto-2);
    margin: 0;
  }

  /* Explorá la plataforma */
  .explora-seccion {
    text-align: center;
  }
  .explora-h2 {
    margin-bottom: 32px;
  }
  .explora-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
  }
  .explora-card {
    text-decoration: none;
    padding: 30px 22px;
    border-radius: 20px;
    background: var(--crema);
    border: 1px solid var(--borde);
    box-shadow: var(--sombra-tarjeta);
    transition: transform 0.18s, box-shadow 0.18s;
  }
  .explora-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px -14px rgba(0, 0, 0, 0.28);
  }
  .explora-icono {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--rojo-suave);
    margin: 0 auto 14px;
  }
  .explora-titulo {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 16.5px;
    color: var(--tinta);
    margin-bottom: 6px;
  }
  .explora-desc {
    font-size: 13px;
    color: var(--tenue);
    line-height: 1.5;
  }

  /* Misión */
  .seccion-mision {
    padding-top: 48px;
    padding-bottom: 72px;
  }
  .mision-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: center;
  }
  .mision-img-wrap {
    position: relative;
  }
  .mision-img {
    width: 100%;
    height: 440px;
    object-fit: cover;
    border-radius: 22px;
    background: var(--img-fallback);
  }
  .mision-badge {
    position: absolute;
    left: -14px;
    bottom: -18px;
    background: var(--rojo);
    color: #fff;
    border-radius: 18px;
    padding: 18px 22px;
    box-shadow: 0 18px 40px -18px rgba(212, 35, 43, 0.7);
  }
  .mision-badge-anio {
    font-family: var(--font-head);
    font-weight: 900;
    font-size: 30px;
    line-height: 1;
  }
  .mision-badge-sub {
    font-size: 12.5px;
    font-weight: 600;
    opacity: 0.9;
    margin-top: 2px;
  }
  .mision-h2 {
    font-weight: 800;
    font-size: 36px;
    letter-spacing: -1px;
    margin: 10px 0 18px;
    line-height: 1.1;
    color: var(--tinta);
  }
  .mision-p {
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--texto-2);
    margin: 0 0 18px;
  }
  .mision-lista {
    list-style: none;
    padding: 0;
    margin: 0 0 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .mision-lista li {
    display: flex;
    gap: 11px;
    align-items: flex-start;
    font-size: 15.5px;
    color: #3a3633;
  }
  .tick {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--verde);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 1px;
  }

  @media (max-width: 900px) {
    .grid-3 {
      grid-template-columns: 1fr;
    }
    .mision-grid,
    .seccion-ods,
    .seccion-mv {
      grid-template-columns: 1fr;
    }
    .ods-img {
      height: 220px;
    }
  }
</style>
