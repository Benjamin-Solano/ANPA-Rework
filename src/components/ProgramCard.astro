---
import type { Programa } from '../data/programas.ts';
interface Props {
  programa: Programa;
}
const { programa: p } = Astro.props;
const bg = p.tone === 'rojo' ? 'var(--rojo)' : 'var(--verde)';
---

<a class="prog-card" href={`/programas#${p.slug}`}>
  <div class="prog-img-wrap">
    <img class="prog-img" src={p.img} alt={p.alt} width="600" height="400" loading="lazy" />
    <span class="prog-icono" aria-hidden="true" style={`background:${bg}`} set:html={p.icon}></span>
  </div>
  <div class="prog-cuerpo">
    <h3 class="prog-titulo">{p.title}</h3>
    <p class="prog-desc">{p.desc}</p>
    <span class="enlace-accion">
      Conocer más
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
    </span>
  </div>
</a>

<style>
  .prog-card {
    display: flex;
    flex-direction: column;
    background: var(--blanco);
    border: 1px solid var(--borde);
    border-radius: 20px;
    overflow: hidden;
    text-decoration: none;
    box-shadow: var(--sombra-tarjeta);
    transition: transform 0.18s, box-shadow 0.18s;
  }
  .prog-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 26px 50px -30px rgba(0, 0, 0, 0.5);
  }
  .prog-img-wrap {
    position: relative;
    height: 178px;
  }
  .prog-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--img-fallback);
  }
  .prog-icono {
    position: absolute;
    left: 16px;
    bottom: -22px;
    width: 50px;
    height: 50px;
    border-radius: 14px;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 20px -8px rgba(0, 0, 0, 0.4);
  }
  .prog-cuerpo {
    padding: 34px 22px 24px;
  }
  .prog-titulo {
    font-weight: 800;
    font-size: 21px;
    margin: 0 0 8px;
    color: var(--tinta);
  }
  .prog-desc {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--texto-3);
    margin: 0 0 16px;
  }
  .enlace-accion {
    font-size: 14.5px;
  }
</style>
