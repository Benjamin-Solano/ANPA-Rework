---
interface Props {
  title: string;
  tag: string;
  tone: 'rojo' | 'verde';
  date: Date;
  image: string;
  alt: string;
  excerpt: string;
}
const { title, tag, tone, date, image, alt, excerpt } = Astro.props;

const fecha = new Intl.DateTimeFormat('es-CR', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
}).format(date);

const tagBg = tone === 'rojo' ? 'var(--rojo-suave)' : 'var(--verde-suave)';
const tagFg = tone === 'rojo' ? 'var(--rojo)' : 'var(--verde)';
---

<a class="news-card" href="#">
  <img class="news-img" src={image} alt={alt} width="600" height="380" loading="lazy" />
  <div class="news-cuerpo">
    <div class="news-meta">
      <span class="news-tag" style={`background:${tagBg};color:${tagFg}`}>{tag}</span>
      <span class="news-fecha">{fecha}</span>
    </div>
    <h3 class="news-titulo">{title}</h3>
    <p class="news-excerpt">{excerpt}</p>
  </div>
</a>

<style>
  .news-card {
    display: flex;
    flex-direction: column;
    background: var(--blanco);
    border: 1px solid var(--borde);
    border-radius: 18px;
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.18s, box-shadow 0.18s;
    box-shadow: 0 14px 36px -30px rgba(0, 0, 0, 0.3);
  }
  .news-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 26px 50px -30px rgba(0, 0, 0, 0.5);
  }
  .news-img {
    width: 100%;
    height: 172px;
    object-fit: cover;
    background: var(--img-fallback);
  }
  .news-cuerpo {
    padding: 22px;
  }
  .news-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 11px;
  }
  .news-tag {
    font-weight: 700;
    font-size: 11.5px;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 999px;
  }
  .news-fecha {
    font-size: 12.5px;
    color: var(--tenue-2);
    font-weight: 600;
  }
  .news-titulo {
    font-weight: 700;
    font-size: 18px;
    line-height: 1.3;
    margin: 0 0 8px;
    color: var(--tinta);
  }
  .news-excerpt {
    font-size: 14px;
    line-height: 1.6;
    color: var(--texto-3);
    margin: 0;
  }
</style>
