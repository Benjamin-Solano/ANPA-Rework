---
import Logo from './Logo.astro';
import ContactForm from './ContactForm.tsx';

const redes = [
  {
    label: 'Facebook',
    href: 'https://facebook.com',
    icon: '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M14 9h3l.5-3.5H14V3.8c0-1 .3-1.7 1.7-1.7H17.6V-.9C17.3-.9 16-.9 14.6-.9c-2.9 0-4.6 1.7-4.6 4.9V5.5H7V9h3v9.5h4z" transform="translate(0 2)"/></svg>',
  },
  {
    label: 'Instagram',
    href: 'https://instagram.com',
    icon: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>',
  },
  {
    label: 'YouTube',
    href: 'https://youtube.com',
    icon: '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M22 8.2a3 3 0 0 0-2.1-2.1C18 5.6 12 5.6 12 5.6s-6 0-7.9.5A3 3 0 0 0 2 8.2 31 31 0 0 0 1.6 12 31 31 0 0 0 2 15.8a3 3 0 0 0 2.1 2.1c1.9.5 7.9.5 7.9.5s6 0 7.9-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 22.4 12 31 31 0 0 0 22 8.2zM10 15V9l5.2 3z"/></svg>',
  },
];

const anio = new Date().getFullYear();
---

<footer class="footer" role="contentinfo">
  <div class="footer-grid contenedor">
    <div>
      <div class="footer-marca">
        <Logo size={44} variant="claro" />
      </div>
      <p class="footer-desc">
        Asociación Nacional Protectora de Animales. La entidad de bienestar animal más antigua de Costa
        Rica, declarada de utilidad pública desde 2019.
      </p>
      <div class="footer-redes">
        {redes.map((r) => <a href={r.href} class="footer-red" aria-label={r.label} set:html={r.icon} />)}
      </div>
    </div>

    <nav class="footer-nav" aria-label="Enlaces del pie">
      <h3 class="footer-titulo">Navegación</h3>
      <a href="/" class="footer-link">Inicio</a>
      <a href="/programas" class="footer-link">Programas</a>
      <a href="/#impacto" class="footer-link">Nuestro impacto</a>
      <a href="/#noticias" class="footer-link">Noticias</a>
      <a href="/#aliados" class="footer-link">Aliados</a>
      <a href="/donar" class="footer-link">Donar</a>
    </nav>

    <div>
      <h3 class="footer-titulo">Escríbenos</h3>
      <ContactForm client:idle />
    </div>
  </div>

  <div class="footer-bottom contenedor">
    <span>© {anio} ANPA · Asociación Nacional Protectora de Animales. Todos los derechos reservados.</span>
    <span class="footer-legal">
      <a href="/#privacidad">Privacidad</a>
      <a href="/#transparencia">Transparencia</a>
    </span>
  </div>
</footer>

<style>
  .footer {
    background: var(--tinta-footer);
    color: var(--footer-texto);
    font-family: var(--font-body);
  }
  .footer-grid {
    padding-top: 64px;
    display: grid;
    grid-template-columns: 1.3fr 1fr 1.4fr;
    gap: 48px;
  }
  .footer-marca {
    margin-bottom: 18px;
  }
  .footer-desc {
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--footer-texto-2);
    max-width: 300px;
    margin: 0 0 20px;
  }
  .footer-redes {
    display: flex;
    gap: 9px;
  }
  .footer-red {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--footer-chip);
    color: #bbb3aa;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }
  .footer-red:hover {
    background: var(--rojo);
    color: #fff;
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .footer-titulo {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: #fff;
    margin: 0 0 16px;
  }
  .footer-link {
    color: var(--footer-texto-2);
    text-decoration: none;
    font-size: 14.5px;
    padding: 6px 0;
    transition: color 0.15s;
  }
  .footer-link:hover {
    color: #fff;
  }

  .footer-bottom {
    margin-top: 48px;
    padding-top: 22px;
    padding-bottom: 22px;
    border-top: 1px solid var(--footer-borde);
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    color: var(--footer-tenue);
  }
  .footer-legal {
    display: flex;
    gap: 18px;
  }
  .footer-legal a {
    color: var(--footer-tenue);
    text-decoration: none;
  }

  /* Footer móvil (§5.1: ≤820px) */
  @media (max-width: 820px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
